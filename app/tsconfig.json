{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true, "checkJs": false,
    "baseUrl": ".", "paths": { "@/*": ["src/*"], "@sdk/*": ["../sdk/src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
